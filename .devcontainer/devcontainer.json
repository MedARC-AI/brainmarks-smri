// Isolated dev environment for running Claude Code with permissions bypassed.
// Only the project folder is mounted; egress is limited to public HTTP(S) (see init-firewall.sh).
{
  "name": "brain_datasets",
  "build": {
    "dockerfile": "Dockerfile",
    "args": { "TZ": "${localEnv:TZ:UTC}" }
  },
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "remoteUser": "vscode",
  // Keep running after the VS Code window closes, so Remote Control sessions stay reachable.
  "shutdownAction": "none",
  "updateRemoteUserUID": true,
  // Same path as on the host, so paths in scripts, manifests and Claude's project memory agree.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "mounts": [
    "source=brain-datasets-claude-config,target=/home/vscode/.claude,type=volume",
    "source=brain-datasets-history,target=/home/vscode/.history,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "HISTFILE": "/home/vscode/.history/bash_history",
    "PROMPT_COMMAND": "history -a"
  },
  // Don't hand the host's SSH agent to processes in the container.
  "remoteEnv": { "SSH_AUTH_SOCK": "" },
  "postCreateCommand": "test -f ~/.claude/settings.json || echo '{\"permissions\": {\"defaultMode\": \"bypassPermissions\"}}' > ~/.claude/settings.json",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand",
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "ms-python.python"]
    }
  }
}
